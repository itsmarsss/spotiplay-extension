{
  "manifest_version": 3,
  "name": "SpotiPlay",
  "description": "SpotiPlay: Seamlessly access and control Spotify within your Chrome browser through this Chrome Extension.",
  "version": "1.0.0",
  "action": {
    "default_popup": "index.html"
  },
  "content_scripts": [
    {
      "matches": ["*://*.spotify.com/*"],
      "js": ["spotifyInterceptor.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["*://*.spotify.com/*"],
      "js": ["contentScript.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["tabs", "storage"],
  "web_accessible_resources": [
    {
      "resources": ["pageInterceptor.js"],
      "matches": ["*://*.spotify.com/*"]
    }
  ]
}
